# ============================================================================
# BioLens Vietnam — Cấu hình Biến môi trường Mẫu (.env.example)
# Sao chép file này thành `.env` (cp .env.example .env) nếu muốn tùy chỉnh.
# ============================================================================

# Đường dẫn thư mục gốc chứa 3,570 thư mục ảnh loài
BIOLENS_DATASET_ROOT=E:/VietMediSpecies2026/dataset

# Đường dẫn file CSV Metadata chuẩn GBIF (4,799 bản ghi)
BIOLENS_METADATA_CSV=E:/VietMediSpecies2026/dataset/VietMediSpecies2026_metadata_dataset.csv

# Đường dẫn thư mục lưu trữ Catalog, Embeddings, Checkpoints và Báo cáo
BIOLENS_STORAGE_DIR=E:/VietMediSpecies2026/BioLens/storage

# Số lượng ảnh tối đa mỗi loài đưa vào huấn luyện:
# - Đặt 0 (hoặc để trống): Sử dụng toàn bộ 100% dữ liệu (310,647 ảnh — Khuyên dùng)
# - Đặt 30: Chế độ lấy mẫu nhanh (~88,896 ảnh) dành cho máy cấu hình thấp
BIOLENS_MAX_IMAGES_PER_SPECIES=0

# Cấu hình Trích xuất Đặc trưng & Huấn luyện GPU
BIOLENS_IMAGE_SIZE=224
BIOLENS_BATCH_SIZE=256
BIOLENS_NUM_WORKERS=4

# Cấu hình Máy chủ Web FastAPI
BIOLENS_HOST=127.0.0.1
BIOLENS_PORT=8000
